@page "/"

<PageTitle>Gorillas</PageTitle>

<div class="page-intro">
    <h1>Gorillas</h1>
    <p>A modern .NET take on the classic banana-lobbing artillery duel.</p>
</div>

<div class="mode-grid">
    <a class="mode-card" href="/solo">
        <span class="mode-title">Play the computer</span>
        <span class="mode-detail">One player against a computer gorilla, easy to hard.</span>
    </a>
    <a class="mode-card" href="/online">
        <span class="mode-title">Play online</span>
        <span class="mode-detail">Create a game and send a friend the link. Watchers welcome.</span>
    </a>
    <a class="mode-card" href="/play">
        <span class="mode-title">Hot seat</span>
        <span class="mode-detail">Two players taking turns on one keyboard.</span>
    </a>
    <a class="mode-card" href="/replays">
        <span class="mode-title">Replays</span>
        <span class="mode-detail">Watch any past match back, shot by shot.</span>
    </a>
</div>
