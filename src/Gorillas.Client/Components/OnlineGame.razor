@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (_session is null)
{
    <div class="gorillas-lobby">
        <label>
            Nickname
            <input type="text" maxlength="20" placeholder="Ada" @bind="_nickname" disabled="@(!_ready)" />
        </label>

        <div class="lobby-actions">
            <button type="button" @onclick="CreateAsync" disabled="@(_busy || !_ready)">Create a game</button>
        </div>

        <div class="lobby-solo">
            <label>
                Computer opponent
                <select @bind="_difficulty" disabled="@(!_ready)">
                    <option value="@AiDifficulty.Easy">Easy</option>
                    <option value="@AiDifficulty.Normal">Normal</option>
                    <option value="@AiDifficulty.Hard">Hard</option>
                </select>
            </label>
            <button type="button" @onclick="PlayComputerAsync" disabled="@(_busy || !_ready)">Play the computer</button>
        </div>

        <div class="lobby-join">
            <label>
                Game code
                <input type="text" maxlength="10" placeholder="BAN-7Q3" @bind="_code" disabled="@(!_ready)" />
            </label>
            <button type="button" @onclick="() => JoinAsync(false)" disabled="@(_busy || !_ready)">Join</button>
            <button type="button" class="secondary" @onclick="() => JoinAsync(true)" disabled="@(_busy || !_ready)">Watch</button>
        </div>

        @if (_error is { } error)
        {
            <p class="gorillas-error">@error</p>
        }
    </div>
}
else
{
    <div class="gorillas-online">
        <div class="online-bar">
            <span class="code">Code <strong>@_session.GameCode</strong></span>
            <span class="role">@RoleLabel</span>
            <span class="link @ConnectionClass">@ConnectionLabel</span>
        </div>

        <div class="share-bar">
            <input type="text" readonly value="@JoinUrl" onfocus="this.select()" />
            <button type="button" @onclick="() => CopyAsync(JoinUrl)">@(_copied == JoinUrl ? "Copied" : "Copy invite")</button>
            <button type="button" class="secondary" @onclick="() => CopyAsync(WatchUrl)">@(_copied == WatchUrl ? "Copied" : "Copy watch link")</button>
        </div>

        <GorillasBoard Session="_session" />

        @if (_session.Participants.Count > 0)
        {
            <ul class="participants">
                @foreach (var participant in _session.Participants)
                {
                    <li class="@(participant.Connected ? "online" : "offline")">
                        @participant.Nickname
                        <span class="tag">@(participant.Role == GameRole.Observer ? "watching" : $"seat {participant.Slot + 1}")</span>
                    </li>
                }
            </ul>
        }
    </div>
}

@code {
    private NetworkGameSession? _session;
    private IJSObjectReference? _identity;
    private IJSObjectReference? _share;
    private string _playerId = string.Empty;
    private string _nickname = string.Empty;
    private string _code = string.Empty;
    private AiDifficulty _difficulty = AiDifficulty.Normal;
    private string? _error;
    private string? _copied;
    private bool _busy;
    private bool _ready;

    /// <summary>Set from the URL so a shared link drops straight into the right game.</summary>
    [Parameter]
    public string? InitialCode { get; set; }

    /// <summary>A "come and watch" link, which must never claim a playing seat.</summary>
    [Parameter]
    public bool InitialWatch { get; set; }

    private string JoinUrl => $"{Nav.BaseUri}online?code={_session?.GameCode}";

    private string WatchUrl => $"{JoinUrl}&watch=1";

    private string RoleLabel => _session?.IsSpectator == true ? "Watching" : $"Seat {(_session?.MySlot ?? 0) + 1}";

    private string ConnectionLabel => _session?.Status switch
    {
        ConnectionStatus.Connected => "live",
        ConnectionStatus.Reconnecting => "reconnecting...",
        ConnectionStatus.Connecting => "connecting...",
        _ => "offline",
    };

    private string ConnectionClass => _session?.Status == ConnectionStatus.Connected ? "ok" : "warn";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _identity = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Gorillas.Client/gorillas-identity.js");
        _share = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Gorillas.Client/gorillas-share.js");
        _playerId = await _identity.InvokeAsync<string>("playerId");

        var remembered = await _identity.InvokeAsync<string>("nickname");
        if (_nickname.Length == 0 && remembered.Length > 0)
        {
            _nickname = remembered;
        }

        if (!string.IsNullOrWhiteSpace(InitialCode))
        {
            _code = InitialCode;
        }

        // The lobby is prerendered before the circuit connects. Anything typed in that window
        // is silently discarded on the first interactive render, so the form stays disabled
        // until we know we are live.
        _ready = true;
        StateHasChanged();

        await TryAutoJoinAsync();
    }

    /// <summary>
    /// Follows a shared link straight into the game, but only once we know what to call the
    /// player — a join claims a seat, so it must not happen under a placeholder name.
    /// </summary>
    private async Task TryAutoJoinAsync()
    {
        if (string.IsNullOrWhiteSpace(InitialCode) || _session is not null)
        {
            return;
        }

        if (!InitialWatch && string.IsNullOrWhiteSpace(_nickname))
        {
            _error = "Pick a nickname, then join the game.";
            StateHasChanged();
            return;
        }

        await JoinAsync(InitialWatch);
    }

    private async Task CopyAsync(string url)
    {
        _copied = _share is not null && await _share.InvokeAsync<bool>("copy", url) ? url : null;

        if (_copied is null)
        {
            _error = "Could not copy automatically — select the link and copy it manually.";
        }

        StateHasChanged();
    }

    private async Task CreateAsync() => await StartAsync(session => session.CreateGameAsync());

    private async Task PlayComputerAsync() => await StartAsync(session => session.CreateSoloGameAsync(_difficulty));

    private async Task JoinAsync(bool asObserver)
    {
        if (string.IsNullOrWhiteSpace(_code))
        {
            _error = "Enter a game code to join.";
            return;
        }

        await StartAsync(session => session.JoinGameAsync(_code, asObserver));
    }

    private async Task StartAsync(Func<NetworkGameSession, Task<JoinResult>> action)
    {
        _busy = true;
        _error = null;

        var session = new NetworkGameSession(
            Nav.ToAbsoluteUri(GameHubRoutes.Path),
            _playerId,
            string.IsNullOrWhiteSpace(_nickname) ? "Anonymous" : _nickname);

        try
        {
            await session.ConnectAsync();
            var result = await action(session);

            if (!result.Success)
            {
                _error = result.Error;
                await session.DisposeAsync();
                return;
            }

            if (_identity is not null)
            {
                await _identity.InvokeVoidAsync("rememberNickname", _nickname);
            }

            _session = session;
        }
        catch (Exception ex)
        {
            _error = $"Could not reach the server: {ex.Message}";
            await session.DisposeAsync();
        }
        finally
        {
            _busy = false;

            // Auto-join runs from OnAfterRenderAsync, which — unlike an event handler — does
            // not re-render automatically, so the swap to the board must be requested here.
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_session is not null)
        {
            await _session.DisposeAsync();
        }

        if (_identity is not null)
        {
            try
            {
                await _identity.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone.
            }
        }

        if (_share is not null)
        {
            try
            {
                await _share.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone.
            }
        }
    }
}
